# OpenAI-compatible endpoint. The dev tunnel rotates; copy this file to .env and
# update LLM_BASE_URL when the old one stops answering.
LLM_BASE_URL=https://distance-podcasts-formatting-scoop.trycloudflare.com/v1
LLM_API_KEY=ollama
LLM_MODEL=k2-horizon-mova-36b-a4b

# This is a reasoning model: prompt + output must stay under 50,000 tokens, so the
# completion cap keeps room for the prompt. H3 enforces the rest of the budget.
LLM_MAX_TOKENS=4096
HARNESS_CONTEXT_WINDOW=50000
LLM_TIMEOUT=600

# Loop guard: model calls per user turn before the loop gives up.
HARNESS_MAX_ITERATIONS=12

# Where sessions are stored (SQLite; ignored by git).
HARNESS_DB=sessions.db

# Tool policy. Leave the allowlist empty to offer every registered tool.
# HARNESS_ALLOWED_TOOLS=search_medical_literature,echo
HARNESS_MAX_TOOL_CALLS=12

# Leave unset for the model default; some reasoning models reject temperature != 1.
# LLM_TEMPERATURE=

# GraphRAG corpus and artifacts. Defaults are the full 24-article corpus and
# graphrag/artifacts. Point GRAPHRAG_CORPUS at test/data/corpus_mini for the
# three-article live run used by the evaluation.
# GRAPHRAG_CORPUS=/absolute/path/to/test/data/corpus_mini
# GRAPHRAG_ARTIFACTS=/absolute/path/to/graphrag/artifacts

# Extraction: attempts per chunk for an empty/unparseable answer, and how many
# consecutive provider failures stop the run instead of failing every chunk.
# GRAPHRAG_EXTRACT_ATTEMPTS=2
# GRAPHRAG_ENDPOINT_FAILURE_LIMIT=3
