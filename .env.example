# OpenAI-compatible endpoint. The dev tunnel rotates; copy this file to .env and
# update LLM_BASE_URL when the old one stops answering.
LLM_BASE_URL=https://distance-podcasts-formatting-scoop.trycloudflare.com/v1
LLM_API_KEY=ollama
LLM_MODEL=k2-horizon-mova-36b-a4b

# This is a reasoning model: prompt + output must stay under 50,000 tokens, so the
# completion cap keeps room for the prompt. H3 enforces the rest of the budget.
LLM_MAX_TOKENS=4096
HARNESS_CONTEXT_WINDOW=50000
LLM_TIMEOUT=600

# Loop guard: model calls per user turn before the loop gives up.
HARNESS_MAX_ITERATIONS=12

# Where sessions are stored (SQLite; ignored by git).
HARNESS_DB=sessions.db

# Leave unset for the model default; some reasoning models reject temperature != 1.
# LLM_TEMPERATURE=
